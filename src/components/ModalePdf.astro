---
// Les PDF du site (menus, listes de fournitures…) s'ouvrent dans une fenêtre qu'on referme, sans
// quitter le site (demande de Charles du 19/10/2026, sur le modèle du catalogue Balinaisa).
// Tout lien vers un PDF du site l'ouvre, sans rien à ajouter au lien. Restent au comportement du
// navigateur : clic avec Ctrl, Cmd ou Maj, navigateur sans lecteur PDF intégré, petit écran (sur
// téléphone, un PDF dans une fenêtre ne se lit pas : il s'ouvre en plein écran et « Retour »
// ramène au site), et sans JavaScript.
---

<dialog class="modale-pdf" aria-labelledby="modale-pdf-titre">
  <div class="mp-barre">
    <p class="mp-titre" id="modale-pdf-titre"></p>
    <button class="mp-fermer" type="button">Fermer<span aria-hidden="true"> ×</span></button>
  </div>
  <iframe title="Document PDF"></iframe>
</dialog>

<script>
  const modale = document.querySelector<HTMLDialogElement>('.modale-pdf');
  const cadre = modale?.querySelector('iframe');
  const titre = modale?.querySelector('.mp-titre');
  // Lien « Télécharger » ajouté à la première ouverture, avec son adresse : un lien sans adresse dans la
  // page serait signalé comme non explorable par les moteurs.
  const telecharger = document.createElement('a');
  telecharger.className = 'mp-telecharger';
  telecharger.textContent = 'Télécharger';
  telecharger.setAttribute('download', '');
  const possible = () => navigator.pdfViewerEnabled !== false && matchMedia('(min-width: 48rem)').matches;
  if (modale && cadre && titre && telecharger) {
    let declencheur: HTMLElement | null = null;
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const adresse = new URL(a.href, location.href);
      if (adresse.origin !== location.origin || !adresse.pathname.toLowerCase().endsWith('.pdf') || !possible()) return;
      e.preventDefault();
      // Libellé du lien sans « (PDF) » ni le texte réservé aux lecteurs d'écran.
      const libelle = [...a.childNodes].filter((n) => !(n instanceof Element && n.classList.contains('visuellement-cache')))
        .map((n) => n.textContent).join('').replace(/\s*\(PDF\)\s*/i, '').replace(/^Voir (\S)/, (_, c) => c.toUpperCase()).trim();
      titre.textContent = libelle || 'Document';
      cadre.title = libelle || 'Document PDF';
      cadre.src = `${adresse.href}#navpanes=0&view=FitH`;
      telecharger.href = adresse.href;
      if (!telecharger.isConnected) modale.querySelector('.mp-fermer')?.before(telecharger);
      declencheur = a;
      modale.showModal();
    });
    modale.querySelector('.mp-fermer')?.addEventListener('click', () => modale.close());
    // Clic sur le voile, autour de la fenêtre : on referme.
    modale.addEventListener('click', (e) => { if (e.target === modale) modale.close(); });
    modale.addEventListener('close', () => {
      cadre.removeAttribute('src');
      declencheur?.focus();
    });
  }
</script>

<style>
  .modale-pdf {
    width: min(64rem, 100vw - 2rem); height: calc(100dvh - 2rem); max-width: none; max-height: none;
    margin: auto; padding: 0; border: 0; border-radius: var(--rayon); overflow: hidden; background: var(--fond);
    display: none; flex-direction: column;
  }
  .modale-pdf[open] { display: flex; }
  .modale-pdf::backdrop { background: rgb(19 16 13 / 0.6); }
  .mp-barre { display: flex; align-items: center; gap: 1rem; padding: 0.75rem 0.75rem 0.75rem 1.25rem; border-bottom: 1px solid #e7e3dc; }
  .mp-titre { flex: 1; margin: 0; font: 700 1.0625rem/1.3 var(--titre); color: var(--encre); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mp-barre :global(.mp-telecharger) { font: 600 var(--t-petit)/1.2 var(--texte); color: var(--bleu); }
  .mp-fermer {
    min-height: 2.75rem; padding: 0.5rem 1.1rem; border: 2px solid var(--bleu); border-radius: var(--rayon-bouton);
    background: transparent; color: var(--bleu); font: 600 1rem/1.2 var(--texte); cursor: pointer;
  }
  .mp-fermer:hover { background: var(--bleu); color: #fff; }
  .modale-pdf iframe { flex: 1; width: 100%; border: 0; background: var(--creme); }
</style>

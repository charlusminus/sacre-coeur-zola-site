---
// Mesure d'audience Google Analytics (propriété « sacre-coeur-zola », demande de Charles du 19/10/2026).
// Google Analytics n'est pas exempté de consentement (CNIL) : rien ne part chez Google sans un clic sur
// « Accepter », même logique que quiypense.org. Choix gardé six mois (clé « consent-ga »), cookies GA
// limités à 13 mois. Le lien « Cookies » du pied de page rouvre le bandeau. Site en ligne seulement :
// la démo et la préproduction ne mesurent rien.
// Présentation (demande de Charles du 21/10/2026) : panneau d'un tiers d'écran en bas, comme sur balinaisa.com, et
// reste de la page voilé et inactif jusqu'au choix, comme sur quiypense.org. « Refuser » et « Accepter » ont le
// même poids (CNIL).
import { lien } from '../lib/site';
---

<div class="consent" role="dialog" aria-modal="true" aria-labelledby="consent-titre" hidden>
  <div class="consent-panneau"><div class="conteneur consent-boite">
    <div>
      <h2 id="consent-titre">Mesure d'audience</h2>
      <p>Avec votre accord, nous comptons les visites avec Google Analytics pour savoir quelles pages sont utiles aux familles. Cela dépose un cookie. <a href={lien('mentions-legales/#cookies')}>En savoir plus</a></p>
    </div>
    <div class="consent-actions">
      <button class="btn btn-secondaire" type="button" data-choix="non">Refuser</button>
      <button class="btn btn-secondaire" type="button" data-choix="oui">Accepter</button>
    </div>
  </div></div>
</div>

<script>
  const ID = 'G-Z7E5M4G3DW';
  const CLE = 'consent-ga';
  const SIX_MOIS = 1000 * 60 * 60 * 24 * 182;
  const w = window as unknown as { dataLayer: unknown[]; gtag: (...a: unknown[]) => void };
  w.dataLayer = w.dataLayer || [];
  w.gtag = function () { w.dataLayer.push(arguments); };
  w.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });

  let charge = false;
  const charger = () => {
    if (charge) return;
    charge = true;
    w.gtag('consent', 'update', { analytics_storage: 'granted' });
    const sc = document.createElement('script');
    sc.async = true;
    sc.src = `https://www.googletagmanager.com/gtag/js?id=${ID}`;
    document.head.appendChild(sc);
    w.gtag('js', new Date());
    w.gtag('config', ID, { cookie_expires: 60 * 60 * 24 * 395 });
  };
  const lire = (): boolean | null => {
    try {
      const v = JSON.parse(localStorage.getItem(CLE) || 'null');
      return v && Date.now() - v.t < SIX_MOIS ? v.ok : null;
    } catch { return null; }
  };
  const ecrire = (ok: boolean) => { try { localStorage.setItem(CLE, JSON.stringify({ ok, t: Date.now() })); } catch { /* navigation privée */ } };

  const bandeau = document.querySelector<HTMLElement>('.consent');
  // Ouvert : le reste de la page est voilé, ne défile plus et n'est plus atteignable au clavier.
  const afficher = (ouvert: boolean) => {
    if (!bandeau) return;
    bandeau.hidden = !ouvert;
    document.documentElement.classList.toggle('consent-ouvert', ouvert);
    for (const el of document.body.children) if (el !== bandeau && el.tagName !== 'SCRIPT') (el as HTMLElement).inert = ouvert;
    if (ouvert) bandeau.querySelector<HTMLElement>('[data-choix="non"]')?.focus();
  };
  if (bandeau) {
    bandeau.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('[data-choix]');
      if (!b) return;
      const ok = b.getAttribute('data-choix') === 'oui';
      ecrire(ok);
      afficher(false);
      if (ok) charger();
      // Retrait du consentement : on supprime les cookies déjà posés.
      else document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((n) => n.startsWith('_ga'))
        .forEach((n) => { document.cookie = `${n}=; max-age=0; path=/; domain=.${location.hostname.replace(/^www\./, '')}`; });
    });
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest('[data-cookies]');
      if (!a) return;
      e.preventDefault();
      afficher(true);
    });
    const choix = lire();
    if (choix === true) charger();
    // Pas d'ouverture d'office sur les mentions légales : « En savoir plus » y mène, il faut pouvoir les lire.
    else if (choix === null && !location.pathname.includes('/mentions-legales/')) afficher(true);
  }
</script>

<style>
  .consent {
    position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end;
    background: rgb(19 16 13 / 0.55);
  }
  .consent-panneau {
    width: 100%; min-height: 33vh; min-height: 33svh; display: flex; align-items: center;
    background: var(--fond); border-top: 1px solid #e7e3dc; box-shadow: 0 -12px 40px rgb(19 16 13 / 0.18);
    padding-block: 1.75rem calc(1.75rem + env(safe-area-inset-bottom, 0px));
  }
  .consent-boite { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 3rem; }
  .consent-boite > div:first-child { flex: 1 1 30rem; max-width: 40rem; }
  .consent h2 { font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem); margin-bottom: 0.6rem; }
  .consent p { font-size: var(--t-corps); line-height: 1.6; }
  .consent-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .consent-actions .btn { min-width: 9rem; }
  :global(html.consent-ouvert) { overflow: hidden; }
  @media (max-width: 32.5rem) { .consent-actions { width: 100%; } .consent-actions .btn { flex: 1; } }
</style>

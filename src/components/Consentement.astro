---
// Mesure d'audience Google Analytics (propriété « sacre-coeur-zola », demande de Charles du 19/10/2026).
// Google Analytics n'est pas exempté de consentement (CNIL) : rien ne part chez Google sans un clic sur
// « Accepter », même logique que quiypense.org. Choix gardé six mois (clé « consent-ga »), cookies GA
// limités à 13 mois. Le lien « Cookies » du pied de page rouvre le bandeau. Site en ligne seulement :
// la démo et la préproduction ne mesurent rien.
import { lien } from '../lib/site';
---

<aside class="consent" aria-labelledby="consent-titre" hidden>
  <div class="conteneur consent-boite">
    <div>
      <h2 id="consent-titre">Mesure d'audience</h2>
      <p>Avec votre accord, nous comptons les visites avec Google Analytics pour savoir quelles pages sont utiles aux familles. Cela dépose un cookie. <a href={lien('mentions-legales/#cookies')}>En savoir plus</a></p>
    </div>
    <div class="consent-actions">
      <button class="btn btn-secondaire" type="button" data-choix="non">Refuser</button>
      <button class="btn btn-secondaire" type="button" data-choix="oui">Accepter</button>
    </div>
  </div>
</aside>

<script>
  const ID = 'G-Z7E5M4G3DW';
  const CLE = 'consent-ga';
  const SIX_MOIS = 1000 * 60 * 60 * 24 * 182;
  const w = window as unknown as { dataLayer: unknown[]; gtag: (...a: unknown[]) => void };
  w.dataLayer = w.dataLayer || [];
  w.gtag = function () { w.dataLayer.push(arguments); };
  w.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });

  let charge = false;
  const charger = () => {
    if (charge) return;
    charge = true;
    w.gtag('consent', 'update', { analytics_storage: 'granted' });
    const sc = document.createElement('script');
    sc.async = true;
    sc.src = `https://www.googletagmanager.com/gtag/js?id=${ID}`;
    document.head.appendChild(sc);
    w.gtag('js', new Date());
    w.gtag('config', ID, { cookie_expires: 60 * 60 * 24 * 395 });
  };
  const lire = (): boolean | null => {
    try {
      const v = JSON.parse(localStorage.getItem(CLE) || 'null');
      return v && Date.now() - v.t < SIX_MOIS ? v.ok : null;
    } catch { return null; }
  };
  const ecrire = (ok: boolean) => { try { localStorage.setItem(CLE, JSON.stringify({ ok, t: Date.now() })); } catch { /* navigation privée */ } };

  const bandeau = document.querySelector<HTMLElement>('.consent');
  if (bandeau) {
    bandeau.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('[data-choix]');
      if (!b) return;
      const ok = b.getAttribute('data-choix') === 'oui';
      ecrire(ok);
      bandeau.hidden = true;
      if (ok) charger();
      // Retrait du consentement : on supprime les cookies déjà posés.
      else document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((n) => n.startsWith('_ga'))
        .forEach((n) => { document.cookie = `${n}=; max-age=0; path=/; domain=.${location.hostname.replace(/^www\./, '')}`; });
    });
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest('[data-cookies]');
      if (!a) return;
      e.preventDefault();
      bandeau.hidden = false;
      bandeau.querySelector<HTMLElement>('[data-choix="non"]')?.focus();
    });
    const choix = lire();
    if (choix === true) charger();
    else if (choix === null) bandeau.hidden = false;
  }
</script>

<style>
  .consent {
    position: fixed; inset: auto 0 0; z-index: 40; background: var(--fond);
    border-top: 1px solid #e7e3dc; box-shadow: 0 -12px 24px -16px rgb(19 16 13 / 0.35);
  }
  .consent-boite { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; padding-block: 1rem; }
  .consent-boite > div:first-child { flex: 1 1 28rem; }
  .consent h2 { font-size: var(--t-h3); margin-bottom: 0.25rem; }
  .consent p { font-size: var(--t-petit); }
  .consent-actions { display: flex; gap: 0.75rem; }
  .consent-actions .btn { min-width: 8rem; }
</style>

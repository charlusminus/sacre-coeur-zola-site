---
import type { CollectionEntry } from 'astro:content';
interface Props { evenements: CollectionEntry<'evenements'>[] }
const { evenements } = Astro.props;
const jour = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', timeZone: 'Europe/Paris' });
const mois = new Intl.DateTimeFormat('fr-FR', { month: 'short', timeZone: 'Europe/Paris' });
const complet = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' });
---
<ul class="agenda">
  {evenements.map((e) => (
    <li>
      <div class="date-bloc" aria-hidden="true"><strong>{jour.format(e.data.debut)}</strong><span>{mois.format(e.data.debut).replace('.', '')}</span></div>
      <div>
        {e.data.public !== "Familles de l'école" && <span class:list={['etiquette', { 'etiquette-forte': e.data.public === 'Futures familles' }]}>{e.data.public}</span>}
        <h3>{e.data.titre}</h3>
        <p class="discret">{[
          complet.format(e.data.debut) + (e.data.fin ? ` au ${complet.format(e.data.fin)}` : ''),
          e.data.horaires,
          e.data.lieu !== 'École Sacré-Cœur La Salle' ? e.data.lieu : undefined,
        ].filter(Boolean).join(', ')}</p>
        <p>{e.data.resume}</p>
      </div>
    </li>
  ))}
</ul>

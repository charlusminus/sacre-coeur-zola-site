---
import { menuDeLaSemaine, jours } from '../lib/contenu';
const menu = await menuDeLaSemaine();
const du = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
---
{menu && (
  <>
    <p class="discret">Semaine du {du.format(menu.data.semaine)}</p>
    <ul class="menu-jours" style="margin-top:1rem">
      {jours.map((j) => { const r = menu.data[j]; return r && (
        <li>
          <h3>{j}{r.vegetarien && <span class="etiquette"> · végétarien</span>}</h3>
          <ul>
            {r.entree && <li>{r.entree}</li>}
            <li class="plat">{r.plat}</li>
            {r.accompagnement && <li>{r.accompagnement}</li>}
            {r.laitage && <li>{r.laitage}</li>}
            {r.dessert && <li>{r.dessert}</li>}
          </ul>
        </li>
      ); })}
    </ul>
  </>
)}

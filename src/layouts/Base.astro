---
import '../styles/tokens.css';
import '../styles/site.css';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import { lien } from '../lib/site';

interface Props { titre: string; description: string; courant?: string; image?: string; schema?: object }
const { titre, description, courant = '', image, schema } = Astro.props;
const enLigne = import.meta.env.PUBLIC_EN_LIGNE === 'oui';
const canonique = new URL(Astro.url.pathname, Astro.site).href;
const titreComplet = titre.includes('Sacré-Cœur') ? titre : `${titre} · École Sacré-Cœur La Salle, Nantes`;
const ogImage = new URL(image ?? lien('partage.jpg'), Astro.site).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {!enLigne && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={lien('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={lien('apple-touch-icon.png')} />
    <link rel="preload" href={lien('fonts/nunito.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lien('fonts/fira-400.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lien('fonts/fira-600.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`@font-face{font-family:'Nunito';font-weight:200 1000;font-display:optional;src:url(${lien('fonts/nunito.woff2')}) format('woff2')}@font-face{font-family:'Fira Sans';font-weight:400;font-display:optional;src:url(${lien('fonts/fira-400.woff2')}) format('woff2')}@font-face{font-family:'Fira Sans';font-weight:600;font-display:optional;src:url(${lien('fonts/fira-600.woff2')}) format('woff2')}`}></style>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    {!enLigne && <p class="bandeau-demo">Maquette de démonstration, proposée par l'APEL. Contenus à valider par l'école.</p>}
    <Entete courant={courant} />
    <main id="contenu">
      <slot />
    </main>
    <Pied />
  </body>
</html>

---
import { pageCantine as t, paragraphes } from '../lib/pages';
import Base from '../layouts/Base.astro';
import MenusCantine from '../components/MenusCantine.astro';
import { lien } from '../lib/site';
---
<Base titre="Menus de la cantine" courant="cantine/" fil={[{ nom: 'Vie scolaire', href: 'vie-scolaire/' }, { nom: 'Menus de la cantine' }]}
  description="Le menu de la semaine à la cantine de l'école Sacré-Cœur La Salle (Nantes, quartier Zola) : repas cuisinés le matin même, un produit bio par jour.">
  <section class="tete-page conteneur">
    <p class="surtitre">Vie scolaire</p>
    <h1>Les menus de la cantine</h1>
    <p class="chapo">{t.chapo}</p>
  </section>

  <section class="section section-creme" aria-labelledby="titre-semaine">
    <div class="conteneur">
      <h2 id="titre-semaine" style="margin-bottom:1rem">Le menu de la semaine</h2>
      <MenusCantine />
      <p class="discret" style="margin-top:1rem">Tous les menus sont aussi sur <a href="https://www.clicetmiam.fr">clicetmiam.fr</a> (code {t.codeClicetmiam}).</p>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-fonctionnement">
    <div class="conteneur">
      <h2 id="titre-fonctionnement" style="margin-bottom:1.5rem">Comment ça marche</h2>
      <ul class="fiches fiches-3">
        {t.fiches.map((x) => <li><h3>{x.titre}</h3>{paragraphes(x.texte).map((y) => <p>{y}</p>)}</li>)}
      </ul>
      <div class="actions"><a class="btn btn-secondaire" href={lien('vie-scolaire/')}>Voir les horaires et la garderie</a></div>
    </div>
  </section>
</Base>

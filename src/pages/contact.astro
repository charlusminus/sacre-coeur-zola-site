---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import p from '../contenus/parametres.json';
import batiment from '../assets/photos/ecole-cour.jpg';
const tel = (n: string) => 'tel:+33' + n.replace(/\s/g, '').slice(1);
const carte = `https://www.openstreetmap.org/?mlat=${p.geo.latitude}&mlon=${p.geo.longitude}#map=17/${p.geo.latitude}/${p.geo.longitude}`;
const itineraire = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${p.adresse.rue}, ${p.adresse.codePostal} ${p.adresse.ville}`)}`;
---
<Base titre="Contact et accès" courant="contact/" description="Adresse, téléphone, horaires du secrétariat et accès de l'école Sacré-Cœur La Salle, 24 rue de la Salle Verte, Nantes Zola.">
  <section class="tete-page conteneur">
    <p class="surtitre">Contact</p>
    <h1>Venir nous voir</h1>
  </section>
  <section class="section section-creme">
    <div class="conteneur duo">
      <div class="prose">
        <h2 style="margin-top:0">École Sacré-Cœur La Salle</h2>
        <p>{p.adresse.rue}<br />{p.adresse.codePostal} {p.adresse.ville}, quartier {p.adresse.quartier}</p>
        <p><a href={itineraire}>Itinéraire</a> · <a href={carte}>Voir sur la carte</a></p>
        <h3>Secrétariat, {p.secretariat}</h3>
        <p><a href={tel(p.telephone)}>{p.telephone}</a> ou <a href={tel(p.telephoneMobile)}>{p.telephoneMobile}</a><br /><a href={`mailto:${p.emailSecretariat}`}>{p.emailSecretariat}</a></p>
        <ul>{p.horairesSecretariat.map((h) => <li>{h.jours} : {h.heures}</li>)}</ul>
        <h3>Direction, {p.direction}</h3>
        <p><a href={`mailto:${p.emailDirection}`}>{p.emailDirection}</a></p>
        <h3>APEL</h3>
        <p><a href="mailto:contact-apel@sacrecoeurzola.fr">contact-apel@sacrecoeurzola.fr</a></p>
        <h3>Accès</h3>
        <p>Bus : arrêt Zola, lignes 11 et 23. [À CONFIRMER : stationnement et dépose minute]</p>
        <p>Absence d'un enfant : SMS au <a href={tel(p.telephoneMobile)}>{p.telephoneMobile}</a>.</p>
      </div>
      <div class="photo-ronde"><Image src={batiment} alt="La cour et la façade en bois de l'école." widths={[390, 800]} sizes="(min-width: 56rem) 40vw, 100vw" /></div>
    </div>
  </section>
</Base>

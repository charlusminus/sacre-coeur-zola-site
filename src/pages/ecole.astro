---
import { parametres as p } from '../lib/donnees';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { lien } from '../lib/site';
import tableau from '../assets/photos/tableau.jpg';
import { pageEcole as t, paragraphes } from '../lib/pages';
---
<Base titre="L'école : projet éducatif et histoire" courant="ecole/" fil={[{ nom: "L'école" }]}
  description="L'école Sacré-Cœur La Salle de Nantes : école catholique lasallienne fondée en 1864, 8 classes de la PS au CM2, projet éducatif 2025-2030, APEL et OGEC.">
  <section class="tete-page conteneur">
    <p class="surtitre">{t.surtitre}</p>
    <h1>{t.titre}</h1>
    <p class="chapo">{t.chapo}</p>
  </section>

  <section class="section section-creme" aria-labelledby="titre-mot">
    <div class="conteneur etroit prose">
      <h2 id="titre-mot" style="margin-top:0">{t.motTitre}</h2>
      {paragraphes(t.motTexte).map((x) => <p>{x}</p>)}
      <p class="mot-signature">{p.directionNom}, {p.directionFonction}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-projet">
    <div class="conteneur">
      <p class="surtitre">{t.projetSurtitre}</p>
      <h2 id="titre-projet" style="margin-bottom:2rem">{t.projetTitre}</h2>
      <ul class="axes">
        {t.axes.map((x) => <li><h3>{x.titre}</h3><ul>{x.points.map((pt) => <li>{pt}</li>)}</ul></li>)}
      </ul>
    </div>
  </section>

  <section class="section section-creme" aria-labelledby="titre-classes">
    <div class="conteneur duo duo-centre">
      <div>
        <h2 id="titre-classes">{t.equipeTitre}</h2>
        {paragraphes(t.equipeTexte).map((x) => <p style="margin-top:1rem">{x}</p>)}
        <table class="tableau" style="margin-top:1.25rem">
          <caption class="discret" style="text-align:left;caption-side:bottom;padding-top:.75rem">L'équipe {p.anneeEquipe}.</caption>
          <tbody>
            {p.equipe.map((l) => <tr><th scope="row">{l.role}</th><td>{l.noms}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="photo-ronde"><Image src={t.photo ?? tableau} alt={t.alt ?? "Un élève, de dos, montre une réponse au tableau numérique de sa classe."} widths={t.photo ? [390, 780] : [281]} sizes="(min-width: 56rem) 40vw, 100vw" /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-histoire">
    <div class="conteneur duo">
      <div>
        <h2 id="titre-histoire">{t.histoireTitre}</h2>
        {paragraphes(t.histoireTexte).map((x) => <p style="margin-top:1rem">{x}</p>)}
      </div>
      <ul class="journee">
        {t.dates.map((x) => <li><span class="heure">{x.annee}</span><span>{x.texte}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section section-creme" aria-labelledby="titre-vivre">
    <div class="conteneur">
      <h2 id="titre-vivre" style="margin-bottom:1.5rem">Vivre l'école</h2>
      <ul class="portes">
        <li><a href={lien('vie-des-classes/')}><h3>La vie des classes</h3><p>Sorties, potager, bibliothèque, gym : ce que vivent les élèves, de la petite section au CM2.</p></a></li>
        <li><a href={lien('eco-ecole/')}><h3>Éco-École</h3><p>Un thème par an, des projets menés par les élèves, un label niveau Or en 2026.</p></a></li>
        <li><a href={lien('pastorale/')}><h3>La pastorale</h3><p>Une école lasallienne : temps forts, célébrations à Saint-Clair, solidarité.</p></a></li>
        <li><a href={lien('apel/')}><h3>L'APEL</h3><p>Les parents qui font vivre l'école : fêtes, vide-grenier, sorties financées.</p></a></li>
      </ul>
      <div class="prose" style="margin-top:2.5rem;max-width:42rem">
        <h3>L'OGEC</h3>
        {paragraphes(t.ogecTexte).map((x) => <p>{x}</p>)}
        <h3>Le réseau La Salle</h3>
        {paragraphes(t.reseauTexte).map((x) => <p>{x}</p>)}
      </div>
    </div>
  </section>

</Base>

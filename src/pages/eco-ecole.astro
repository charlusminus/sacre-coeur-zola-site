---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Actus from '../components/Actus.astro';
import { getCollection } from 'astro:content';
import potager from '../assets/actualites/potager-cp.jpg';
import { pageEcoEcole as t, paragraphes, apresDeuxPoints } from '../lib/pages';
const actus = (await getCollection('actualites')).filter((a) => a.data.rubrique === 'Éco-École').sort((a, b) => +b.data.date - +a.data.date).slice(0, 9);
---
<Base titre="Éco-École : le label niveau Or" courant="eco-ecole/" fil={[{ nom: "L'école", href: 'ecole/' }, { nom: 'Éco-École' }]}
  description="Déchets, biodiversité, eau, alimentation : depuis 2023, les classes de l'école Sacré-Cœur La Salle à Nantes vivent Éco-École, label niveau Or en 2026.">
  <section class="tete-page conteneur">
    <p class="surtitre">{t.surtitre}</p>
    <h1>{t.titre}</h1>
    <p class="chapo">{t.chapo}</p>
  </section>

  <section class="section section-creme" aria-labelledby="titre-annees">
    <div class="conteneur duo duo-centre">
      <div>
        <h2 id="titre-annees">{t.anneesTitre}</h2>
        <ul class="journee" style="margin-top:1.5rem">
          {t.annees.map((x) => <li><span class="heure">{x.annee}</span><span><strong>{x.theme}</strong> : {apresDeuxPoints(x.texte)}</span></li>)}
        </ul>
      </div>
      <div class="photo-ronde"><Image src={t.photo ?? potager} alt={t.alt ?? "Les lettres « CP » dessinées avec des pousses dans la terre du potager."} widths={[390, 780]} sizes="(min-width: 56rem) 40vw, 100vw" /></div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur etroit prose">
      <h2 style="margin-top:0">{t.elevesTitre}</h2>
      {paragraphes(t.elevesTexte).map((x) => <p>{x}</p>)}
    </div>
  </section>

  <section class="section section-creme" aria-labelledby="titre-actus">
    <div class="conteneur">
      <h2 id="titre-actus" style="margin-bottom:2rem">Les projets des classes</h2>
      <Actus actus={actus} />
    </div>
  </section>
</Base>

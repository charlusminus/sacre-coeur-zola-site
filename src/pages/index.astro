---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Agenda from '../components/Agenda.astro';
import MenuDuJour from '../components/MenuDuJour.astro';
import p from '../contenus/parametres.json';
import { lien, dateLongue } from '../lib/site';
import { evenementsAVenir, actualites } from '../lib/contenu';
import { schemaEcole } from '../lib/schema';
import cour from '../assets/photos/ecole-cour.jpg';
import cabanes from '../assets/photos/bibliotheque-cabanes.jpg';
import bibliotheque from '../assets/photos/bibliotheque.jpg';
import potager from '../assets/photos/potager.jpg';
import forum from '../assets/photos/forum.jpg';

const aVenir = await evenementsAVenir();
const visite = aVenir.find((e) => e.data.public === 'Futures familles');
const prochains = [...(visite ? [visite] : []), ...aVenir.filter((e) => e !== visite)].slice(0, 3);
const jourLong = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
const dernieres = await actualites(3);
---
<Base titre="École Sacré-Cœur La Salle, école privée maternelle et élémentaire à Nantes Zola"
  description="École catholique sous contrat de la petite section au CM2, quartier Zola à Nantes. 210 élèves, 8 classes, accueil de 7 h 45 à 18 h 30. Inscriptions ouvertes."
  schema={schemaEcole(Astro.site, import.meta.env.BASE_URL)}>

  <section class="une" aria-labelledby="titre-une">
    <div class="une-photo">
      <Image src={cour} alt="La cour de l'école neuve, son olivier et sa façade en bois, rue de la Salle Verte." widths={[390, 780, 1200]} sizes="(min-width: 56rem) 50vw, 100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="une-texte">
      <p class="surtitre">École maternelle et élémentaire, quartier Zola à Nantes</p>
      <h1 id="titre-une">Une école à taille humaine, où tout le monde se connaît</h1>
      <p class="chapo">De la petite section au CM2, 210 élèves grandissent ici dans la tradition éducative de saint Jean-Baptiste de La Salle : apprendre avec exigence, avec attention à chacun.</p>
      <div class="actions actions-une">
        <a class="btn btn-principal" href={lien('inscriptions/#demande')}>Inscrire mon enfant</a>
        <a class="btn btn-secondaire" href={lien('inscriptions/#visiter')}>Visiter l'école</a>
      </div>
      {visite && <p class="rendez-vous"><strong>Portes ouvertes</strong> le {jourLong.format(visite.data.debut)}{visite.data.horaires ? `, ${visite.data.horaires}` : ''}</p>}
    </div>
  </section>

  <ul class="faits conteneur" aria-label="L'école en bref">
    {p.chiffres.map((c) => <li><strong>{c.valeur}</strong><span>{c.libelle}</span></li>)}
  </ul>

  <section class="section" aria-labelledby="titre-projet">
    <div class="conteneur">
      <div class="entete-section">
        <div>
          <p class="surtitre">Semer les savoirs, cultiver les talents</p>
          <h2 id="titre-projet">Ce que vos enfants vivent ici</h2>
        </div>
        <a class="lien-fleche" href={lien('ecole/')}>Le projet éducatif</a>
      </div>
      <ul class="vecu">
        <li>
          <Image src={bibliotheque} alt="Des élèves de CP et CE1 lisent, assis par terre dans la bibliothèque." widths={[390, 700]} sizes="(min-width: 56rem) 40vw, 100vw" />
          <h3>Lire et faire lire : une bibliothèque vivante</h3>
          <p>Une bibliothèque à cabanes au cœur de l'école neuve, où les classes viennent lire ensemble.</p>
        </li>
        <li>
          <Image src={potager} alt="Des mains d'enfants plantent des graines dans un bac de terre." widths={[390, 600]} sizes="(min-width: 56rem) 30vw, 100vw" />
          <h3>Label Éco-École niveau Or</h3>
          <p>Potager, jardinières, eau de pluie : toutes les classes portent le projet, récompensé en juin 2026.</p>
        </li>
        <li>
          <Image src={forum} alt="Tous les élèves réunis, assis au forum de l'école." widths={[390, 600]} sizes="(min-width: 56rem) 30vw, 100vw" />
          <h3>Toute l'école réunie chaque mois</h3>
          <p>L'assemblée mensuelle : chaque classe présente un projet, et l'on fête les anniversaires du mois.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section-creme" aria-labelledby="titre-mot">
    <div class="conteneur etroit">
      <h2 id="titre-mot" class="surtitre">Le mot de la cheffe d'établissement</h2>
      <blockquote>
        <p class="mot">« Ici, tout le monde se connaît et se reconnaît. Notre mission est claire : accueillir chaque élève tel qu'il est, avec bienveillance, en portant une attention toute particulière aux plus fragiles. »</p>
        <footer class="mot-signature">Hélène Lampérière, cheffe d'établissement. <a href={lien('ecole/')}>Lire son mot en entier</a></footer>
      </blockquote>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-inscription">
    <div class="conteneur">
      <div class="entete-section">
        <div>
          <p class="surtitre">Rentrée {p.rentree}, inscriptions ouvertes</p>
          <h2 id="titre-inscription">Inscrire votre enfant, en quatre étapes</h2>
        </div>
        <p>Pour une rentrée en septembre ou en cours d'année, de la petite section au CM2. Nous vous répondons sous deux jours ouvrés.</p>
      </div>
      <ol class="etapes">
        <li><h3>Votre demande</h3><p>Six questions, deux minutes, en ligne ou par téléphone.</p></li>
        <li><h3>Un rendez-vous</h3><p>Avec la cheffe d'établissement, pour faire connaissance.</p></li>
        <li><h3>La visite</h3><p>Classes, cour, cantine : venez en famille.</p></li>
        <li><h3>Le dossier</h3><p>Nous confirmons l'inscription et préparons la rentrée.</p></li>
      </ol>
      <div class="actions">
        <a class="btn btn-principal" href={lien('inscriptions/#demande')}>Faire ma demande</a>
        <a class="btn btn-secondaire" href={lien('inscriptions/')}>Tarifs et questions fréquentes</a>
      </div>
    </div>
  </section>

  <section class="section section-creme" aria-labelledby="titre-journee">
    <div class="conteneur duo duo-centre">
      <div>
        <p class="surtitre">Une journée au Sacré-Cœur</p>
        <h2 id="titre-journee">De 7 h 45 à 18 h 30, quatre jours par semaine</h2>
        <ul class="journee" style="margin-top:1.5rem">
          <li><span class="heure">7 h 45</span><span>Accueil du matin en garderie</span></li>
          <li><span class="heure">8 h 30</span><span>Classe jusqu'à 11 h 45</span></li>
          <li><span class="heure">11 h 45</span><span>Déjeuner : repas cuisinés le matin même, livrés chauds ; self pour les élémentaires</span></li>
          <li><span class="heure">13 h 30</span><span>Classe jusqu'à 16 h 30</span></li>
          <li><span class="heure">16 h 40</span><span>Garderie, avec étude obligatoire jusqu'à 17 h 30 du CP au CM2</span></li>
          <li><span class="heure">18 h 30</span><span>Fin de l'accueil du soir</span></li>
        </ul>
        <p class="discret" style="margin-top:1rem">Lundi, mardi, jeudi et vendredi. Pas de classe le mercredi.</p>
      </div>
      <div class="photo-ronde">
        <Image src={cabanes} alt="Une classe assise dans la bibliothèque aux cabanes en bois." widths={[390, 700]} sizes="(min-width: 56rem) 40vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-agenda">
    <div class="conteneur duo">
      <div>
        <div class="entete-section"><h2 id="titre-agenda">À venir</h2><a class="lien-fleche" href={lien('agenda/')}>Tout l'agenda</a></div>
        <Agenda evenements={prochains} />
      </div>
      <div>
        <div class="entete-section"><h2 id="titre-menu">À la cantine</h2><a class="lien-fleche" href={lien('vie-scolaire/#cantine')}>Les menus de la semaine</a></div>
        <MenuDuJour />
      </div>
    </div>
  </section>

  <section class="section section-creme" aria-labelledby="titre-actus">
    <div class="conteneur">
      <div class="entete-section"><h2 id="titre-actus">La vie de l'école</h2><a class="lien-fleche" href={lien('agenda/#actualites')}>Toutes les actualités</a></div>
      <ul class="actus">
        {dernieres.map((a) => (
          <li>
            <a href={lien(`actualites/${a.id}/`)}>
              {a.data.photo && <Image src={a.data.photo} alt={a.data.alt ?? ''} widths={[390, 560]} sizes="(min-width: 48rem) 33vw, 100vw" />}
              <span class="etiquette">{a.data.rubrique} · {dateLongue(a.data.date)}</span>
              <h3>{a.data.titre}</h3>
              <p>{a.data.resume}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>


</Base>

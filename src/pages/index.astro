---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Agenda from '../components/Agenda.astro';
import MenusCantine from '../components/MenusCantine.astro';
import { parametres as p } from '../lib/donnees';
import { lien, dateLongue } from '../lib/site';
import { evenementsAVenir, actualites } from '../lib/contenu';
import assemblee from '../assets/photos/assemblee.jpg';
import cour from '../assets/photos/ecole-cour.jpg';
import potager from '../assets/photos/potager.jpg';
import jardinieres from '../assets/photos/jardinieres.jpg';

const aVenir = await evenementsAVenir();
const visite = aVenir.find((e) => e.data.public === 'Futures familles');
const prochains = aVenir.filter((e) => e !== visite).slice(0, 4);
const dernieres = await actualites(3);
const jourLong = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
const tel = 'tel:+33' + p.telephone.replace(/\s/g, '').slice(1);
---
<Base titre="École privée Sacré-Cœur La Salle à Nantes Zola, de la PS au CM2"
  description="École Sacré-Cœur La Salle, école catholique sous contrat à Nantes Zola : 210 élèves de la petite section au CM2, accueil 7 h 45 à 18 h 30. Inscriptions ouvertes.">

  <section class="une" aria-labelledby="titre-une">
    <div class="une-photo">
      <Image src={assemblee} alt="Toute l'école réunie dans la grande salle, de dos, écoute trois adultes qui chantent à la guitare." widths={[390, 578]} sizes="(min-width: 56rem) 50vw, 100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="une-texte">
      <p class="surtitre surtitre-lignes"><span><span>École maternelle et élémentaire</span> <span>Quartier Zola à Nantes</span></span></p>
      <h1 id="titre-une">Une école à taille humaine, où tout le monde se connaît</h1>
      <p class="chapo">De la petite section au CM2, 210 élèves grandissent ici dans la tradition éducative de saint Jean-Baptiste de La Salle : apprendre avec exigence, avec attention à chacun.</p>
      <div class="actions actions-une">
        <a class="btn btn-principal" href={lien('inscriptions/#demande')}>Inscrire mon enfant</a>
        <a class="btn btn-secondaire" href={lien('inscriptions/#visiter')}>Visiter l'école</a>
      </div>
      {visite && <p class="discret" style="margin-top:1rem">Portes ouvertes le {jourLong.format(visite.data.debut)}{visite.data.horaires ? `, ${visite.data.horaires}` : ''}. Réponse à votre demande sous deux jours ouvrés.</p>}
    </div>
  </section>


  <section class="section section-creme" aria-labelledby="titre-projet">
    <div class="conteneur">
      <h2 id="titre-projet" class="titre-section">Ce que vos enfants vivent ici</h2>
      <ul class="vecu">
        <li class="vecu-grand">
          <Image src={cour} alt="La cour de l'école neuve, son olivier et sa façade en bois." widths={[390, 780, 1200]} sizes="(min-width: 56rem) 60vw, 100vw" />
          <h3>Une école neuve, inaugurée en 2023</h3>
          <p>Des classes lumineuses, une bibliothèque à cabanes, un forum où toute l'école se réunit chaque mois, un potager et une cour plantée d'un olivier.</p>
        </li>
        <li>
          <Image src={potager} alt="Des mains d'enfants et d'un adulte plantent des graines dans un bac de terre." widths={[390, 780]} sizes="(min-width: 56rem) 30vw, 100vw" />
          <h3>Label Éco-École niveau Or</h3>
          <p>Potager, jardinières, eau de pluie : toutes les classes portent le projet.</p>
        </li>
        <li>
          <Image src={jardinieres} alt="Des jardinières peintes par les élèves de CM, devant une baie vitrée." widths={[390, 780]} sizes="(min-width: 56rem) 30vw, 100vw" />
          <h3>Apprendre en faisant</h3>
          <p>Du potager aux jardinières fabriquées par les CM1-CM2, les projets se mènent en classe, en groupe.</p>
        </li>
      </ul>
      <div class="actions"><a class="btn btn-secondaire" href={lien('vie-des-classes/')}>Voir la vie des classes</a></div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-inscription">
    <div class="conteneur">
      <div class="entete-section">
        <div>
          <p class="surtitre">Rentrée {p.rentree}, inscriptions ouvertes</p>
          <h2 id="titre-inscription">Inscrire votre enfant, en trois étapes</h2>
        </div>
        <p>Pour une rentrée en septembre ou en cours d'année, de la petite section au CM2.</p>
      </div>
      <ol class="etapes">
        <li><h3>Votre demande</h3><p>Quelques questions en ligne, ou un appel au <a href={tel}>{p.telephone}</a>. Réponse sous deux jours ouvrés.</p></li>
        <li><h3>Rendez-vous et visite</h3><p>Avec {p.directionCourt}, {p.directionFonction} : vous faites connaissance et visitez l'école.</p></li>
        <li><h3>Le dossier</h3><p>Vous recevez le dossier ; l'inscription est confirmée à son retour.</p></li>
      </ol>
      <div class="actions">
        <a class="btn btn-principal" href={lien('inscriptions/#demande')}>Inscrire mon enfant</a>
      </div>
    </div>
  </section>

  <section class="section section-creme" aria-labelledby="titre-journee">
    <div class="conteneur duo">
      <div>
        <h2 id="titre-journee">De 7 h 45 à 18 h 30, quatre jours par semaine</h2>
        <ul class="journee" style="margin-top:1.5rem">
          <li><span class="heure">7 h 45</span><span>Accueil du matin en garderie</span></li>
          <li><span class="heure">8 h 30</span><span>Classe jusqu'à 11 h 45</span></li>
          <li><span class="heure">11 h 45</span><span>Déjeuner, self pour les élémentaires</span></li>
          <li><span class="heure">13 h 30</span><span>Classe jusqu'à 16 h 30</span></li>
          <li><span class="heure">16 h 40</span><span>Garderie, avec étude jusqu'à 17 h 30 du CP au CM2</span></li>
          <li><span class="heure">18 h 30</span><span>Fin de l'accueil du soir</span></li>
        </ul>
        <p class="discret" style="margin-top:1rem">Lundi, mardi, jeudi et vendredi. Pas de classe le mercredi.</p>
        <div class="actions"><a class="btn btn-secondaire" href={lien('vie-scolaire/')}>Voir les horaires et la garderie</a></div>
      </div>
      <div>
        <h2 class="titre-bloc">À la cantine</h2>
        <MenusCantine compact />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-agenda">
    <div class="conteneur duo">
      <div>
        <h2 id="titre-agenda" class="titre-section">À venir</h2>
        <Agenda evenements={prochains} />
        <div class="actions"><a class="btn btn-secondaire" href={lien('agenda/')}>Voir tout l'agenda</a></div>
      </div>
      <div>
        <h2 id="titre-actus" class="titre-section">Actualités</h2>
        <ul class="actus-liste">
          {dernieres.map((a) => (
            <li>
              <span class="etiquette">{dateLongue(a.data.date)}</span>
              <h3><a href={lien(`actualites/${a.id}/`)}>{a.data.titre}</a></h3>
              <p>{a.data.resume}</p>
            </li>
          ))}
        </ul>
        <div class="actions"><a class="btn btn-secondaire" href={lien('agenda/#actualites')}>Voir toutes les actualités</a></div>
      </div>
    </div>
  </section>

  <section class="section section-creme" aria-labelledby="titre-mot">
    <div class="conteneur etroit">
      <h2 id="titre-mot" class="surtitre">Le mot de la cheffe d'établissement</h2>
      <blockquote>
        <p class="mot">« Ici, tout le monde se connaît et se reconnaît. Notre mission est claire : accueillir chaque élève tel qu'il est, avec bienveillance, en portant une attention toute particulière aux plus fragiles. »</p>
        <footer class="mot-signature">{p.directionNom}, {p.directionFonction}.</footer>
      </blockquote>
      <div class="actions"><a class="btn btn-secondaire" href={lien('ecole/')}>Lire son mot en entier</a></div>
    </div>
  </section>
</Base>

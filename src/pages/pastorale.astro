---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Actus from '../components/Actus.astro';
import { getCollection } from 'astro:content';
import vierge from '../assets/actualites/paques-vierge.jpg';
import { pagePastorale as t, paragraphes, apresDeuxPoints } from '../lib/pages';
const actus = (await getCollection('actualites')).filter((a) => a.data.rubrique === 'Pastorale').sort((a, b) => +b.data.date - +a.data.date);
---
<Base titre="La pastorale" courant="pastorale/" fil={[{ nom: "L'école", href: 'ecole/' }, { nom: 'Pastorale' }]}
  description="La pastorale de l'école Sacré-Cœur La Salle à Nantes : célébrations à l'église Saint-Clair, temps forts, solidarité, dans le respect des convictions de chacun.">
  <section class="tete-page conteneur">
    <p class="surtitre">{t.surtitre}</p>
    <h1>{t.titre}</h1>
    <p class="chapo">{t.chapo}</p>
  </section>

  <section class="section section-creme">
    <div class="conteneur duo duo-centre">
      <div class="prose">
        <h2 style="margin-top:0">{t.tempsFortsTitre}</h2>
        <ul>
          {t.tempsForts.map((x) => <li><strong>{x.nom}</strong> : {apresDeuxPoints(x.texte)}</li>)}
        </ul>
        {paragraphes(t.tempsFortsTexte).map((x) => <p>{x}</p>)}
        <h2>{t.eveilTitre}</h2>
        {paragraphes(t.eveilTexte).map((x) => <p>{x}</p>)}
      </div>
      <div class="photo-ronde"><Image src={t.photo ?? vierge} alt={t.alt ?? "La statue de la Vierge de la cour élémentaire, entourée des bouquets apportés par les classes."} widths={[390, 780]} sizes="(min-width: 56rem) 40vw, 100vw" /></div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur duo">
      <div class="prose">
        <h2 style="margin-top:0">{t.lasallienneTitre}</h2>
        {paragraphes(t.lasallienneTexte).map((x) => <p>{x}</p>)}
      </div>
      <div class="prose">
        <h2 style="margin-top:0">{t.solidariteTitre}</h2>
        {paragraphes(t.solidariteTexte).map((x) => <p>{x}</p>)}
      </div>
    </div>
  </section>

  {actus.length > 0 && (
    <section class="section section-creme" aria-labelledby="titre-actus">
      <div class="conteneur">
        <h2 id="titre-actus" style="margin-bottom:2rem">La pastorale en images et en mots</h2>
        <Actus actus={actus} />
      </div>
    </section>
  )}
</Base>
